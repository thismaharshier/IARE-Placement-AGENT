# 2. Vector Store Setup
embeddings = GoogleGenerativeAIEmbeddings(model="models/embedding-001")
vector_store = Chroma.from_documents(
    documents=placement_docs,
    embedding=embeddings,
    collection_name="iare_placements"
)

# 3. Define RAG Retrieval Tool
@tool
def search_placement_drives(query: str) -> str:
    """Useful to search for IARE campus placement drives, company criteria, eligibility, dates, stipends, and packages."""
    docs = vector_store.similarity_search(query, k=4)
    return "\n\n---\n\n".join([doc.page_content for doc in docs])

tools = [search_placement_drives]

# 4. Agent Configuration
llm = ChatGoogleGenerativeAI(model="gemini-1.5-pro", temperature=0)

prompt = ChatPromptTemplate.from_messages([
    ("system", "You are the official IARE Campus Placement AI Agent. Use the `search_placement_drives` tool to retrieve factual placement details before answering. Be precise regarding eligibility (CGPA, backlogs, branch), CTC, dates, and interview stages."),
    ("human", "{input}"),
    ("placeholder", "{agent_scratchpad}"),
])

agent = create_tool_calling_agent(llm, tools, prompt)
agent_executor = AgentExecutor(agent=agent, tools=tools, verbose=True)

# 5. Execute Test Queries
if __name__ == "__main__":
    queries = [
        "What companies are hiring the 2027 batch and what are their CGPA cutoffs?",
        "I am interested in Data Analyst and Hardware roles. What options are available and what are their salaries?",
        "Which drives require zero active backlogs and offer 10 LPA or more?"
    ]
    for q in queries:
        print(f"\nUser Query: {q}")
        result = agent_executor.invoke({"input": q})
        print(f"Agent Output:\n{result['output']}\n" + "="*50)
